# Mobile public configuration. Never put a key in an EXPO_PUBLIC_ variable.
# Localhost is replaced with Expo's LAN host on development iPhones.
EXPO_PUBLIC_AI_BASE_URL=http://localhost:8787
# EAS production/preview: https://little-moments-api.onrender.com/receipt-decoded

# Server only. Use a dedicated restricted OpenAI project/key in production.
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4.1-mini
PORT=8787
MAX_REQUEST_BYTES=8388608
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=6
MAX_CONCURRENT_REQUESTS=2
ANALYSIS_TIMEOUT_MS=90000
DAILY_ANALYSIS_LIMIT=100
DAILY_AI_BUDGET_CENTS=500
MONTHLY_AI_BUDGET_CENTS=2000
MAX_SCAN_BUDGET_CENTS=10
USAGE_STATE_PATH=server-data/usage.json
# Set only for a verified proxy topology; never trust arbitrary forwarded headers.
TRUST_PROXY_HOPS=0
