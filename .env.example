# Mobile public configuration. Never put a key in an EXPO_PUBLIC_ variable.
# Localhost is replaced with Expo's LAN host on development iPhones.
EXPO_PUBLIC_AI_BASE_URL=http://localhost:8787
# EAS production/preview: https://little-moments-api.onrender.com/receipt-decoded

# Server only. Use a dedicated restricted OpenAI project/key in production.
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4.1-mini
PORT=8787
MAX_REQUEST_BYTES=8388608
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=6
MAX_CONCURRENT_REQUESTS=2
ANALYSIS_TIMEOUT_MS=90000
DAILY_ANALYSIS_LIMIT=100
DAILY_AI_BUDGET_CENTS=500
MONTHLY_AI_BUDGET_CENTS=2000
MAX_SCAN_BUDGET_CENTS=10
USAGE_STATE_PATH=server-data/usage.json
# Set only for a verified proxy topology; never trust arbitrary forwarded headers.
TRUST_PROXY_HOPS=0

# Optional Details lookup; independent from receipt analysis. Server only.
# Supports gpt-6-luna, gpt-4.1-mini/gpt-4.1 and their 2025-04-14 snapshots.
# Invalid lookup settings disable only lookup; receipt analysis remains available.
OPENAI_PRODUCT_LOOKUP_MODEL=gpt-4.1-mini
PRODUCT_LOOKUP_TIMEOUT_MS=20000
PRODUCT_LOOKUP_MAX_SEARCH_CALLS=3
PRODUCT_LOOKUP_RATE_WINDOW_MS=60000
PRODUCT_LOOKUP_RATE_MAX=6
PRODUCT_LOOKUP_MAX_CONCURRENT=2
PRODUCT_LOOKUP_DAILY_LIMIT=100
PRODUCT_LOOKUP_DAILY_BUDGET_CENTS=500
PRODUCT_LOOKUP_MONTHLY_BUDGET_CENTS=2000
# Conservative reservation per attempt, including failures. Luna/4.1-mini default
# to 25 cents; GPT-4.1 defaults to 110. Below-floor values disable lookup only.
PRODUCT_LOOKUP_BUDGET_CENTS=25
PRODUCT_LOOKUP_USAGE_STATE_PATH=server-data/product-lookup-usage.json
